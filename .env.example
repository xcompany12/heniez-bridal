# Salin file ini menjadi .env.local lalu isi nilainya. Jangan commit .env.local.
# Nilai ada di Supabase: Project Settings > API Keys.

# Project URL (Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), aman dipakai di browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), RAHASIA: hanya dipakai di server, jangan dibagikan
SUPABASE_SECRET_KEY=
